# Required (docker-compose default)
DATABASE_URL=postgres://knoldr:knoldr@localhost:5432/knoldr

# ----- Local LLM (Ollama) -----
# Ollama is the only LLM path (decompose / classify / extract /
# triples / CoVe / QA question generation).
# OLLAMA_HOST=http://host.docker.internal:11434
# KNOLDR_OLLAMA_FAST_MODEL=gemma4:e4b
# KNOLDR_OLLAMA_TIMEOUT_MS=120000

# ----- Server (MCP over Streamable HTTP at /mcp) -----
# No auth: knoldr runs inside a trusted agent ecosystem. Callers identify
# themselves via the optional agentId tool input (attribution only).
# NODE_ENV=production
# KNOLDR_PORT=5100
# KNOLDR_HOST=127.0.0.1            # containers bind 0.0.0.0
# KNOLDR_LOG_LEVEL=info
#
# Connection URL MCP clients use to reach this backend:
# KNOLDR_URL=http://localhost:5100
