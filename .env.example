# Required (docker-compose default)
DATABASE_URL=postgres://knoldr:knoldr@localhost:5432/knoldr

# Required: web search API key (https://langsearch.com/dashboard)
LANGSEARCH_API_KEY=sk-your-key-here

# ----- Local LLM (Ollama) -----
# Ollama is the only LLM path. Fast model is used for single-call
# operations (decompose / classify / extract / triples / CoVe / QA /
# query-decompose / counter-search / paraphrase). Jury models are
# fanned out in parallel for verify-time voting — list at least two
# distinct architectures for meaningful diversity.
# OLLAMA_HOST=http://host.docker.internal:11434
# KNOLDR_OLLAMA_FAST_MODEL=gemma4:e4b
# KNOLDR_OLLAMA_JURY_MODELS=gemma4:e4b,qwen2.5:14b
# KNOLDR_OLLAMA_TIMEOUT_MS=120000

# ----- Server (MCP over Streamable HTTP at /mcp) -----
# Bearer token for the /mcp endpoint. REQUIRED whenever the server binds a
# non-loopback host (e.g. KNOLDR_HOST=0.0.0.0, as docker-compose does) or
# NODE_ENV=production — the process refuses to start otherwise. A loopback
# dev server may omit it (runs unauthenticated with a startup warning).
# Must equal the Authorization bearer your MCP client / plugin sends.
# KNOLDR_API_TOKEN=your-bearer-token
# NODE_ENV=production
# KNOLDR_PORT=5100
# KNOLDR_HOST=127.0.0.1            # containers bind 0.0.0.0 (token then required)
# KNOLDR_LOG_LEVEL=info
#
# Connection URL the Claude Code plugin's .mcp.json uses to reach this
# backend (host side; default localhost:5100):
# KNOLDR_URL=http://localhost:5100

# ----- SSRF allowlist (opt-in) -----
# Comma-separated hostnames the claim verifier may fetch despite
# resolving to private / loopback IPs. Use only for trusted intranet
# sources (e.g. internal wiki).
# KNOLDR_ALLOWED_INTERNAL_HOSTS=wiki.internal,docs.internal
